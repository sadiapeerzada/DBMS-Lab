\f0\fs24 \cf0 CREATE OR REPLACE FUNCTION sort_three(a NUMBER, b NUMBER, c NUMBER)\
RETURN VARCHAR2\
AS\
    x NUMBER := a;\
    y NUMBER := b;\
    z NUMBER := c;\
    temp NUMBER;\
    result VARCHAR2(100);\
BEGIN\
    -- Ascending sort\
    IF x > y THEN temp := x; x := y; y := temp; END IF;\
    IF y > z THEN temp := y; y := z; z := temp; END IF;\
    IF x > y THEN temp := x; x := y; y := temp; END IF;\
\
    result := 'Ascending: ' || x || ', ' || y || ', ' || z ||\
              ' | Descending: ' || z || ', ' || y || ', ' || x;\
\
    RETURN result;\
END;\
/\
\
-- Execute\
SELECT sort_three(5, 2, 9) FROM dual;}
\f0\fs24 \cf0 CREATE OR REPLACE PROCEDURE count_prime_composite(n IN NUMBER)\
AS\
    i NUMBER;\
    j NUMBER;\
    is_prime BOOLEAN;\
    prime_count NUMBER := 0;\
    comp_count NUMBER := 0;\
BEGIN\
    FOR i IN 2..n LOOP\
        is_prime := TRUE;\
\
        FOR j IN 2..i/2 LOOP\
            IF MOD(i, j) = 0 THEN\
                is_prime := FALSE;\
                EXIT;\
            END IF;\
        END LOOP;\
\
        IF is_prime THEN\
            prime_count := prime_count + 1;\
        ELSE\
            comp_count := comp_count + 1;\
        END IF;\
    END LOOP;\
\
    DBMS_OUTPUT.PUT_LINE('Prime count: ' || prime_count);\
    DBMS_OUTPUT.PUT_LINE('Composite count: ' || comp_count);\
END;\
/\
\
-- Execute\
BEGIN\
    count_prime_composite(20);\
END;\
/}
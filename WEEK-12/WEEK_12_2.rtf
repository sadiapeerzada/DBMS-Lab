\f0\fs24 \cf0 CREATE OR REPLACE PROCEDURE sum_even_pos(n IN NUMBER)\
AS\
    num NUMBER := n;\
    digit NUMBER;\
    pos NUMBER := 1;\
    sum_even NUMBER := 0;\
BEGIN\
    WHILE num > 0 LOOP\
        digit := MOD(num, 10);\
\
        IF MOD(pos, 2) = 0 THEN\
            sum_even := sum_even + digit;\
        END IF;\
\
        num := FLOOR(num / 10);\
        pos := pos + 1;\
    END LOOP;\
\
    DBMS_OUTPUT.PUT_LINE('Sum of digits at even positions: ' || sum_even);\
END;\
/\
\
-- Execute\
BEGIN\
    sum_even_pos(123456);\
END;\
/}
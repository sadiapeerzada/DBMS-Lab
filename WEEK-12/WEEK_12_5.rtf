\f0\fs24 \cf0 CREATE OR REPLACE FUNCTION basic_calc(a NUMBER, b NUMBER, op VARCHAR2)\
RETURN NUMBER\
AS\
    res NUMBER;\
BEGIN\
    IF op = '+' THEN\
        res := a + b;\
    ELSIF op = '-' THEN\
        res := a - b;\
    ELSIF op = '*' THEN\
        res := a * b;\
    ELSIF op = '/' THEN\
        IF b = 0 THEN\
            DBMS_OUTPUT.PUT_LINE('Division by zero error');\
            RETURN NULL;\
        END IF;\
        res := a / b;\
    ELSE\
        DBMS_OUTPUT.PUT_LINE('Invalid operator');\
        RETURN NULL;\
    END IF;\
\
    RETURN res;\
END;\
/\
\
-- Execute\
SELECT basic_calc(10, 5, '+') FROM dual;}
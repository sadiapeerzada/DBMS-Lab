SELECT * FROM University WHERE Location = 'Mumbai';\
\
SELECT P.Program_Name\
FROM Program P\
JOIN University U ON P.University_ID = U.University_ID\
WHERE U.University_Name = 'AMU';\
\
SELECT D.Department_Name\
FROM Department D\
JOIN University U ON D.University_ID = U.University_ID\
WHERE U.University_Name = 'JNU';\
\
SELECT P.Program_Name\
FROM Program P\
JOIN University U ON P.University_ID = U.University_ID\
WHERE U.University_Name = 'University of Jammu';\
\
SELECT DISTINCT U.University_Name\
FROM University U\
JOIN Program P ON U.University_ID = P.University_ID\
WHERE P.Program_Name = 'MCA';\
\
SELECT C.Course_Name\
FROM Course C\
JOIN Program P ON C.Program_ID = P.Program_ID\
JOIN University U ON P.University_ID = U.University_ID\
WHERE P.Program_Name = 'MCA' AND U.University_Name = 'AMU';\
\
SELECT Faculty_Name\
FROM Faculty\
WHERE Specialization = 'Information Security';\
\
SELECT U.University_Name, S.Content\
FROM Syllabus S\
JOIN Course C ON S.Course_ID = C.Course_ID\
JOIN Program P ON C.Program_ID = P.Program_ID\
JOIN University U ON P.University_ID = U.University_ID\
WHERE C.Course_Name = 'Computer Architecture';\
\
SELECT F.Faculty_Name, F.Specialization\
FROM Faculty F\
JOIN Department D ON F.Department_ID = D.Department_ID\
JOIN University U ON D.University_ID = U.University_ID\
WHERE D.Department_Name = 'Computer Science'\
AND U.University_Name = 'Delhi University';\
\
SELECT U.University_Name\
FROM University U\
JOIN Program P ON U.University_ID = P.University_ID\
GROUP BY U.University_Name\
ORDER BY COUNT(P.Program_ID) DESC\
LIMIT 1;}